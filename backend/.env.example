# ------------------------------------------------------------------
# Configuracion del backend SIGA-D1. Copia este archivo a .env:
#   cp .env.example .env
# ------------------------------------------------------------------

# Puerto del servidor HTTP
PORT=4000

# Entorno: development | production | test
NODE_ENV=development

# Cadena de conexion de la base de datos.
# SQLite para el prototipo (no requiere instalar nada).
# Para migrar a PostgreSQL basta cambiar el provider en prisma/schema.prisma
# y esta URL, por ejemplo:
#   DATABASE_URL="postgresql://usuario:clave@localhost:5432/siga_d1?schema=public"
DATABASE_URL="file:./dev.db"

# Secreto para firmar los JSON Web Tokens.
# EN PRODUCCION: reemplazar por una cadena larga y aleatoria.
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="8h"

# Origen del frontend permitido por CORS
CORS_ORIGIN="http://localhost:5173"

# ------------------------------------------------------------------
# Reglas de negocio configurables (nunca fijas en el codigo)
# ------------------------------------------------------------------

# Semaforo de riesgo por producto: umbrales en DIAS de inventario restante
# al ritmo de venta actual.
#   dias  >  AMARILLO              -> VERDE   (sin accion)
#   ROJO  <  dias  <=  AMARILLO    -> AMARILLO (reponer pronto)
#   dias  <=  ROJO   (o stock 0)   -> ROJO    (quiebre inminente)
SEMAFORO_DIAS_AMARILLO=7
SEMAFORO_DIAS_ROJO=3

# Numero de movimientos de SALIDA recientes usados para estimar
# el ritmo de venta diario (promedio movil).
VENTAS_MUESTRA=5
